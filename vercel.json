{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "novaranatureestates.com" }],
      "destination": "https://www.novaranatureestates.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://novara-backend-one.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|Exabot|facebot|facebookexternalhit|ia_archiver|LinkedInBot|Twitterbot|WhatsApp|Applebot|AhrefsBot|SemrushBot|MJ12bot|DotBot|rogerbot|PetalBot|screaming.frog|prerender).*"
        }
      ],
      "destination": "https://VtbyI2tdf3UGRiGTHQmj@service.prerender.io/https://www.novaranatureestates.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Prerender-Token", "value": "VtbyI2tdf3UGRiGTHQmj" }]
    }
  ]
}